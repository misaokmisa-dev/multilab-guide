{
  "name": "multilab-guide",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "main": "worker/affiliate-analytics.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/minecraft/strategy/items/detail/*",
      "/minecraft/strategy/rare-mobs/*",
      "/minecraft/strategy/items/detail"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "analytics_engine_datasets": [
    {
      "binding": "MLG_EVENTS",
      "dataset": "mlg_site_events"
    }
  ],
  "analytics": {
    "binding": "MLG_SQL"
  }
}
